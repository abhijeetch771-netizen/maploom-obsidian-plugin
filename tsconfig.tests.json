{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "tests/**/*.test.ts",
    "src/core/note-nodes.ts",
    "src/core/embedded-notes.ts",
    "src/core/callout-content.ts",
    "src/core/table-content.ts",
    "src/core/image-content.ts"
  ]
}
